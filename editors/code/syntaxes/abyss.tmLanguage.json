{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "AbySS",
	"scopeName": "source.abyss",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#types"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#artifact_tokens"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#identifiers"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.abyss",
					"match": "//.*$"
				},
				{
					"name": "comment.block.abyss",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.abyss",
					"match": "\\b(forge|morph|core|oracle|orbit|resume|eject|engrave|reveal|artifact)\\b"
				}
			]
		},
		"types": {
			"patterns": [
				{
					"name": "storage.type.abyss",
					"match": "\\b(arcana|aether|rune|omen|abyss|scroll|lexicon|materia|glyph)\\b"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.abyss",
					"match": "\\b(boon|hex)\\b"
				}
			]
		},
		"functions": {
			"patterns": [
				{
					"name": "support.function.abyss",
					"match": "\\b(unveil|summon|trans)\\b"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.abyss",
					"match": "\\+|\\-|\\*|\\/|\\^|\\*\\*|%|==|!=|<=|>=|<|>|=|\\+=|\\-=|\\*=|\\/=|%=|\\^=|\\*\\*=|::|=>|->|&&|\\|\\||!|\\bas\\b|\\.\\.=|\\.\\."
				}
			]
		},
		"artifact_tokens": {
			"patterns": [
				{
					"match": "\\bartifact\\s+([A-Z][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"name": "entity.name.type.abyss"
						}
					}
				},
				{
					"match": "\\b([A-Z][A-Za-z0-9_]*)\\b(?=\\s*::)",
					"captures": {
						"1": {
							"name": "entity.name.type.abyss"
						}
					}
				},
				{
					"match": "\\b([A-Z][A-Za-z0-9_]*)\\b(?=\\s*\\{)",
					"captures": {
						"1": {
							"name": "entity.name.type.abyss"
						}
					}
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.abyss",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.abyss",
					"match": "\\\\."
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.abyss",
					"match": "\\b[+-]?\\d+\\.?\\d*\\b"
				}
			]
		},
		"identifiers": {
			"patterns": [
				{
					"name": "variable.abyss",
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
				}
			]
		}
	}
}