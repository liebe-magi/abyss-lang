// Capture user input inside a lexicon and retrieve values via rune keys

forge morph profile: lexicon = {
	"name": summon("Input your name: "),
	"focus": summon("What is your favorite spell focus? ")
};

profile["age"] = trans(summon("Input your age: ") as arcana);

unveil(
	"Greetings, ",
	profile["name"],
	"! Age ",
	profile["age"],
	" with focus on ",
	profile["focus"]
);