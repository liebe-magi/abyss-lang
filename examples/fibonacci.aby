// Build the Fibonacci sequence inside a morph scroll and then unveil it

forge terms: arcana = 20;
forge morph fibs: scroll = [0, 1];

orbit (i = 2..terms) {
    forge prev: arcana = fibs[i - 1];
    forge before_prev: arcana = fibs[i - 2];
    inscribe(fibs, prev + before_prev);
};

unveil("Fibonacci (", terms, " terms): ", fibs);